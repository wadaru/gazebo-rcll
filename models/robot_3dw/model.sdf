<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="robot_3dw">
    <static>false</static>
    <link name="body">
      <pose>0 0 0.001 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>30</mass>
        <pose>0 0 0.075 0 0 0</pose>
        <inertia>
	  <!-- according to http://en.wikipedia.org/wiki/List_of_moments_of_inertia for a solid cylinder of radius r=0.225, height h=0.15, mass m=30 -->
          <ixx>0.4359375</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.4359375</iyy>
          <iyz>0.0</iyz>
          <izz>0.759375</izz>
        </inertia>
      </inertial>

      <visual name="body-visual">
        <pose>0.01 0 0.00 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <uri>model://robotino3/meshes/robotino3.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      
      <collision name="body1-collision">
        <pose>0 0 0.735 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.07</length>
            <radius>0.225</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
              <slip1>0.8</slip1>
              <slip2>0.8</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.05</min_depth>
            </ode>
          </contact>
        </surface>
      </collision> 
      
      <collision name="body2-collision">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.68</length>
            <radius>0.06</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
              <slip1>0.8</slip1>
              <slip2>0.8</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.05</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <collision name="body3-collision">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.07</length>
            <radius>0.225</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
              <slip1>0.8</slip1>
              <slip2>0.8</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.05</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="tower">
        <pose>0.00 0.00 0.43 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.09 0.70</size>
          </box>
        </geometry>
      </visual>
      <visual name="tower_plate">
        <pose>0 0 0.79 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.225</radius>
          </cylinder>
        </geometry>
      </visual>
      <!--
      <include>
        <uri>model://hokuyo_noisy</uri>
        <name>/robot_3dw/laser_sensor</name>
        <pose>0.0 -0.15 0.235 0 0 -1.570796</pose>
        <topic_prefix>/robot1</topic_prefix>
      </include>
      -->
      <sensor name="gpu_laser" type="gpu_lidar">
        <pose>0.0 -0.15 0.235 0 0 0</pose>
        <topic>/model/robot_3dw/laser</topic>
        <update_rate>10</update_rate>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>robot_3dw/body</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-2.26889</min_angle>
              <max_angle>2.268899</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>0.01</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <visualize>true</visualize>
      </sensor>
    </link>

    <link name="depth_camera_frame">
      <pose>0 0 1.0 0 0 0</pose>

      <sensor name="depth_camera_3dw" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <topic>/model/robot_3dw/depth_camera</topic>
        <gz_frame_id>robot_3dw/depth_camera_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>256</width>
            <height>256</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="camera_3dw" type="camera">
        <topic>/model/robot_3dw/rgb_camera</topic>
        <gz_frame_id>robot_3dw/rgb_camera_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
	    <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
    </link>
    <joint name="depth_camera_joint" type="fixed">
      <parent>body</parent>
      <child>depth_camera_frame</child>
    </joint>

    <!--
    <joint name="laser_joint" type="fixed">
      <parent>body</parent>
      <child>/robot_3dw/laser_sensor</child>
    </joint>
    -->

    <!--
    <plugin name="Motor" filename="libmotor.so"/>
    <plugin name="Gyro" filename="libgyro.so"/>
    <plugin name="GPS" filename="libgps.so"/>
    <plugin name="LightSignalDetection" filename="liblight_signal_detection.so"/>
    -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <link_name>body</link_name>
      <topic>robot_3dw/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>robot_3dw/odom</odom_frame>
      <odom_topic>/model/robot_3dw/odom</odom_topic>
      <robot_base_frame>robot_3dw/body</robot_base_frame>
      <tf_topic>/model/robot_3dw/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>      
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <static_update_frequency>10</static_update_frequency>
      <publish_nested_models>true</publish_nested_models>
    </plugin>
  </model>
</sdf>
