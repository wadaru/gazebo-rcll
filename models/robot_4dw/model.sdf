<?xml version="1.0" ?>
<sdf version='1.11'>
  <model name='robot_4dw'>
    <link name='base_footprint'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>4.001</mass>
        <gravity>true</gravity>
        <inertia>
          <ixx>1.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0001</iyy>
          <iyz>0</iyz>
          <izz>1.0001</izz>
        </inertia>
      </inertial>
      <visual name='base_footprint_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://myagv_description/meshes/myagv_base.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual_1'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://myagv_description/meshes/myagv_up.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>

      <!-- 元のdaeファイルで描画される -->
      <visual name='w1'>
        <pose>0.11 0.08 0.04 0 0 1.57</pose>
        <geometry><mesh><uri>model://robot_4dw/wheel.dae</uri></mesh></geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>
      <!-- -->

      <!-- 以下の3個が描画されないので追加 -->
      <visual name='w2'>
        <pose>-0.10 0.08 0.04 0 0 1.57</pose>
        <geometry><mesh><uri>model://robot_4dw/wheel.dae</uri></mesh><center>true</center></geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>

      <visual name='w3'>
        <pose>-0.10 -0.12 0.04 0 0 1.57</pose>
        <geometry><mesh><uri>model://robot_4dw/wheel.dae</uri></mesh><center>true</center></geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>

      <visual name='w4'>
        <pose>0.11 -0.12 0.04 0 0 1.57</pose>
        <geometry><mesh><uri>model://robot_4dw/wheel.dae</uri></mesh><center>true></center></geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>


      <collision name="collision_base">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://myagv_description/meshes/myagv_base.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name="gpu_laser" type="gpu_lidar">
        <pose>0.0 0 0.10 0 0 0</pose>
        <topic>/model/robot_4dw/laser</topic>
        <update_rate>10</update_rate>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>robot_4dw/laser_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-2.26889</min_angle>
              <max_angle>2.268899</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>0.01</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <visualize>true</visualize>
      </sensor>
    </link>

    <link name="depth_camera_frame">
      <pose>0 0 1.0 0 0 0</pose>

      <sensor name="depth_camera_4dw" type="depth_camera">
        <topic>/model/robot_4dw/depth_camera</topic>
        <gz_frame_id>robot_4dw/depth_camera_frame</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <topic>/model/robot_4dw/depth_camera</topic>
        <gz_frame_id>robot_4dw/depth_camera_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>256</width>
            <height>256</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    <sensor name="camera_4dw" type="camera">
      <topic>/model/robot_4dw/rgb_camera</topic>
      <gz_frame_id>robot_4dw/rgb_camera_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
	  <format>R8G8B8</format>
        </image>
         <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
    </sensor>
    </link>

    <joint name="depth_camera_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>depth_camera_frame</child>
    </joint>

    <frame name='base_joint' attached_to='base_footprint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
    <link_name>body_footprint</link_name>
    <topic>robot_4dw/cmd_vel</topic>
  </plugin>

  <plugin
    filename="gz-sim-odometry-publisher-system"
    name="gz::sim::systems::OdometryPublisher">
  <odom_frame>robot_4dw/odom</odom_frame>
  <topic>/model/robot_4dw/odom</topic>
  <tf_topic>/model/robot_4dw/tf</tf_topic>
  <dimensions>3</dimensions>
</plugin>

<plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
  <publish_link_pose>true</publish_link_pose>      
  <use_pose_vector_msg>true</use_pose_vector_msg>
  <static_publisher>false</static_publisher>
  <static_update_frequency>10</static_update_frequency>
  <publish_nested_models>true</publish_nested_models>
</plugin>
  </model>
</sdf>
